    {
      "type": "timeseries",
      "id": 15,
      "title": "Container memory working set vs limit",
      "description": "cAdvisor working set per pod vs the container memory limit. KvCacheMemoryHigh fires above 90%.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
